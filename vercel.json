om https://maps.googleapis.com https://*.facebook.com https://*.facebook.net https://connect.facebook.net; frame-src 'self' https://*.google.com https://td.doubleclick.net https://www.googleadservices.com https://www.youtube.com https://www.youtube-nocookie.com https://*.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://script.google.com https://www.facebook.com https://*.facebook.com"
